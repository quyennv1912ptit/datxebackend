# Development only. Replace every placeholder before running or deploying.
POSTGRES_DB=datxe
POSTGRES_USER=datxe
POSTGRES_PASSWORD=replace-this-local-password
REDIS_PASSWORD=replace-this-local-redis-password

# Local application profile. docker-compose overrides DB_URL and REDIS_URL for containers.
DB_URL=jdbc:postgresql://localhost:5432/datxe
DB_USERNAME=datxe
DB_PASSWORD=replace-this-local-password
REDIS_URL=redis://:replace-this-local-redis-password@localhost:6379

FIREBASE_CREDENTIALS_LOCATION=file:./secrets/firebase-service-account.json
MAPBOX_TOKEN=replace-with-mapbox-token
CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Set these to a Firebase user that already exists and to real operational fare values.
BOOTSTRAP_ADMIN_FIREBASE_UID=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_PRICING_ENABLED=false
BOOTSTRAP_PRICING_CAR_BASE_FARE=
BOOTSTRAP_PRICING_CAR_PER_KM=
BOOTSTRAP_PRICING_CAR_MIN_FARE=
BOOTSTRAP_PRICING_MOTORCYCLE_BASE_FARE=
BOOTSTRAP_PRICING_MOTORCYCLE_PER_KM=
BOOTSTRAP_PRICING_MOTORCYCLE_MIN_FARE=

OUTBOX_POLL_INTERVAL_MS=1000
