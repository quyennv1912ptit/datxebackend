# Development only. Replace every placeholder before running or deploying.
POSTGRES_DB=datxe
POSTGRES_USER=datxe
POSTGRES_PASSWORD=replace-this-local-password
REDIS_PASSWORD=replace-this-local-redis-password

# Local application profile. docker-compose overrides DB_URL and REDIS_URL for containers.
DB_URL=jdbc:postgresql://localhost:5432/datxe
DB_USERNAME=datxe
DB_PASSWORD=replace-this-local-password
REDIS_URL=redis://:replace-this-local-redis-password@localhost:6379

FIREBASE_CREDENTIALS_LOCATION=file:./secrets/firebase-service-account.json
CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Set these to a Firebase user that already exists and to real operational fare values.
BOOTSTRAP_ADMIN_FIREBASE_UID=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_PRICING_ENABLED=false
BOOTSTRAP_PRICING_CAR_BASE_FARE=
BOOTSTRAP_PRICING_CAR_PER_KM=
BOOTSTRAP_PRICING_CAR_MIN_FARE=
BOOTSTRAP_PRICING_MOTORCYCLE_BASE_FARE=
BOOTSTRAP_PRICING_MOTORCYCLE_PER_KM=
BOOTSTRAP_PRICING_MOTORCYCLE_MIN_FARE=

OUTBOX_POLL_INTERVAL_MS=1000

SCHEDULED_RIDE_DISPATCH_LEAD_TIME=15m
SCHEDULED_RIDE_EXPIRE_AFTER=10m
SCHEDULED_RIDE_POLL_INTERVAL_MS=30000
SCHEDULED_RIDE_IDLE_RESCAN_DELAY=15s

# Goong REST key for address search, geocoding and directions. Server only.
# Keep this REST API key on the server, never in EXPO_PUBLIC_*.
GOONG_API_KEY=

# Optional driver document extraction. Keep keys on the server.
DATXE_EKYC_ENABLED=false
DATXE_EKYC_ORIGIN=
DATXE_EKYC_API_KEY=
DATXE_EKYC_MODAL_KEY=
DATXE_EKYC_MODAL_SECRET=

# Optional eKYC settings. Store captures outside the source tree when deploying.
# Bật face comparison hoặc protected storage thì bắt buộc phải cung cấp 2 key bên dưới.
DATXE_EKYC_FACE_COMPARISON_ENABLED=false
DATXE_EKYC_MAX_RETRIES=1
DATXE_EKYC_CONNECT_TIMEOUT_MS=5000
DATXE_EKYC_READ_TIMEOUT_MS=65000
DATXE_EKYC_TOTAL_DEADLINE_MS=75000
DATXE_VERIFICATION_STORAGE_DIR=./data/driver-verification-captures
# Bắt buộc khi bật protected storage (app.verification.require-protected-storage=true) hoặc face comparison.
# DATXE_VERIFICATION_ENCRYPTION_KEY=
# Nếu bỏ trống, lookup HMAC key sẽ dùng lại DATXE_VERIFICATION_ENCRYPTION_KEY (xem application.properties).
# DATXE_VERIFICATION_LOOKUP_HMAC_KEY=
# Production only, see docs/release-and-rollback.md.
# DATXE_VERIFICATION_HOST_DIR=/absolute/path/to/protected-storage
# COMPOSE_PROJECT_NAME=ptitgo-backend

# Optional synchronization from the private eKYC verification workflow.
DATXE_VERIFICATION_SYNC_ENABLED=false
DATXE_VERIFICATION_SYNC_ORIGIN=
DATXE_VERIFICATION_SYNC_KEY=

# Bản demo deploy (đồ án sinh viên): bật nạp ví giả lập để trình diễn WALLET.
# Trên server demo, thêm vào .env (hoặc secret ENV_FILE của GitHub Actions):
# SPRING_PROFILES_ACTIVE=demo
# WALLET_MOCK_TOPUP_ENABLED=true

